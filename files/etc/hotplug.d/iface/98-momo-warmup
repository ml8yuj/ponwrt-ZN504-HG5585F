#!/bin/sh

# Trigger warm-up delay test only when PPPoE WAN interface comes up
[ "$ACTION" = "ifup" ] || exit 0
[ "$INTERFACE" = "wan" ] || exit 0

(
    # Wait for WAN IPv4 CGNAT routing to fully settle
    sleep 10

    SECRET="515645"
    API_URL="http://127.0.0.1:9090"

    # Wait up to 30s for sing-box clash API to be ready
    ready=0
    for i in $(seq 1 15); do
        if curl -s -m 2 -H "Authorization: Bearer $SECRET" "$API_URL/version" >/dev/null 2>&1; then
            ready=1
            break
        fi
        sleep 2
    done

    [ "$ready" = "1" ] || exit 0

    # Smoothly probe IPv4 and all proxy nodes with 150ms pacing to avoid CGNAT PPS drops
    PROXIES=$(curl -s -m 5 -H "Authorization: Bearer $SECRET" "$API_URL/proxies" | \
              grep -o '"[^"]*-hy2[^"]*"' | tr -d '"' | sort -u)

    for p in $PROXIES; do
        ENCODED=$(echo "$p" | sed 's/ /%20/g')
        curl -s -m 4 -H "Authorization: Bearer $SECRET" \
             "$API_URL/proxies/$ENCODED/delay?url=http://www.gstatic.com/generate_204&timeout=3000" >/dev/null 2>&1
        sleep 0.15
    done
) >/dev/null 2>&1 &
